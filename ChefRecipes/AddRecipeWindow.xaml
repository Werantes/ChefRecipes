<Window x:Class="ChefRecipes.AddRecipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить рецепт" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Название:" Margin="0,0,0,5"/>
                <TextBox x:Name="TitleBox" Margin="0,0,0,10"/>

                <TextBlock Text="Описание:" Margin="0,0,0,5"/>
                <TextBox x:Name="DescBox" Height="50" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="Время (минуты):" Margin="0,0,0,5"/>
                <TextBox x:Name="TimeBox" Margin="0,0,0,10"/>

                <TextBlock Text="Ингредиенты (строка: название - количество):" Margin="0,0,0,5"/>
                <TextBox x:Name="IngBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                <TextBlock Text="Шаги (каждый с новой строки):" Margin="0,0,0,5"/>
                <TextBox x:Name="StepsBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="Save_Click" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Отмена" Click="Cancel_Click" Padding="15,5"/>
        </StackPanel>
    </Grid>
</Window>