<Window x:Class="ChefRecipes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рецепты шеф-повара" Height="500" Width="700">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <Button Content="Добавить" Click="Add_Click" Margin="0,0,0,5"/>
            <Button Content="Удалить" Click="Delete_Click" Margin="0,0,0,10"/>
            <ListBox x:Name="RecipesList" SelectionChanged="RecipesList_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="DescText" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="TimeText" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Ингредиенты:" FontWeight="Bold" Margin="0,10,0,5"/>
            <ListBox x:Name="IngredientsList" Margin="0,0,0,10"/>
            <TextBlock Text="Приготовление:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox x:Name="StepsList"/>
        </StackPanel>
    </Grid>
</Window>